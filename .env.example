# Bind address and port for the local agent. Leave HOST loopback for normal
# `npm start`; Docker Compose sets HOST=0.0.0.0 so the port can be published.
HOST=127.0.0.1
PORT=3001

# Sampling interval for live metrics (1000-60000 ms).
METRICS_INTERVAL_MS=2000

# Public IP lookup (ipify). Set to false to disable the external call.
PUBLIC_IP_ENABLED=true
PUBLIC_IP_URL=https://api.ipify.org?format=json

# Upper bound for a single external speed test, in bytes (1-100 MB).
SPEEDTEST_MAX_BYTES=52428800

# --- Fleet mode (public/dashboard deployment) ---
# Writable persistent directory for device reports (fleet.json).
DATA_DIR=./data

# Secret required to view device data. Leave empty only for local development.
VIEWER_TOKEN=

# Secret required for scripted enrollment (POST /api/agent/enroll).
# Dashboard enrollment works without this. Leave empty to disable it.
AGENT_ENROLLMENT_TOKEN=

# How long a device is "online" after its last report, and how long a queued
# diagnostic waits for the agent before expiring.
DEVICE_STALE_MS=90000
DEVICE_COMMAND_TTL_MS=60000
